@implements IDisposable
@inject AppStateService AppState
@inject WeatherService Weather

<div class="currency-row @(IsActive ? "active" : "")">
    <button type="button" class="flag-btn" @onclick="() => OnFlagClick.InvokeAsync(Index)">
        <img class="flag" src="flags/@(FlagCountry).svg" alt="" />
        <span class="caret">▾</span>
    </button>
    <div class="code-col">
        <span class="code">@Slot.Code</span>
        @if (forecast is not null)
        {
            <span class="weather-icon">@WeatherService.IconFor(forecast.WeatherCode)</span>
            <span class="weather-temp">@FormatTemp(forecast.TMin)/@FormatTemp(forecast.TMax)</span>
        }
        <span class="local-time">@LocalTime</span>
    </div>
    <input class="amount-input"
           inputmode="none"
           readonly
           value="@Slot.Text"
           @onclick="Activate" />
</div>

@code {
    [Parameter, EditorRequired]
    public int Index { get; set; }

    [Parameter]
    public EventCallback<int> OnFlagClick { get; set; }

    private System.Threading.Timer? clockTimer;
    private WeatherForecast? forecast;
    private string? weatherFetchedForCode;

    private CurrencySlot Slot => AppState.Slots[Index];

    private bool IsActive => AppState.ActiveIndex == Index;

    private string FlagCountry => CurrencyCatalog.Find(Slot.Code)?.FlagCountry ?? "xx";

    private string LocalTime
    {
        get
        {
            var timeZoneId = CurrencyCatalog.Find(Slot.Code)?.TimeZoneId;
            if (timeZoneId is null)
                return "--:--";

            try
            {
                var timeZone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);
                return TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, timeZone).ToString("HH:mm");
            }
            catch (TimeZoneNotFoundException)
            {
                return "--:--";
            }
        }
    }

    protected override void OnInitialized()
    {
        clockTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    protected override void OnParametersSet()
    {
        if (weatherFetchedForCode == Slot.Code)
            return;

        weatherFetchedForCode = Slot.Code;
        forecast = null;
        _ = LoadWeatherAsync(Slot.Code);
    }

    private async Task LoadWeatherAsync(string code)
    {
        var info = CurrencyCatalog.Find(code);
        if (info is null)
            return;

        var result = await Weather.GetForecastAsync(info.Latitude, info.Longitude);
        if (code != Slot.Code)
            return; // la riga è cambiata di nuovo nel frattempo, risultato ormai obsoleto

        forecast = result;
        await InvokeAsync(StateHasChanged);
    }

    private static string FormatTemp(double celsius) => $"{Math.Round(celsius):0}°";

    private void Activate() => AppState.SetActive(Index);

    public void Dispose() => clockTimer?.Dispose();
}
